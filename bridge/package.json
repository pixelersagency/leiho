{
	"name": "leiho",
	"version": "1.0.0-beta.13",
	"description": "Pont postMessage de l'éditeur visuel Leiho : rend n'importe quel site (React, Next.js, Remix, Vite, Nuxt, SvelteKit, Astro, HTML) éditable depuis WordPress. Zéro dépendance, inactif hors de l'éditeur.",
	"keywords": [
		"wordpress",
		"headless",
		"acf",
		"visual-editing",
		"react",
		"nextjs",
		"astro",
		"remix",
		"vite",
		"nuxt",
		"sveltekit"
	],
	"license": "GPL-2.0-or-later",
	"author": "Pixelers (https://pixelers.fr)",
	"type": "module",
	"main": "./dist/leiho-bridge.js",
	"module": "./src/index.js",
	"exports": {
		".": {
			"import": "./src/index.js",
			"default": "./dist/leiho-bridge.js"
		},
		"./react": {
			"import": "./src/react.js"
		},
		"./standalone": "./dist/leiho-bridge.js",
		"./content": {
			"import": "./src/content.js"
		}
	},
	"scripts": {
		"build": "node build.js",
		"test": "node --test"
	},
	"files": [
		"src",
		"dist",
		"bin",
		"README.md"
	],
	"sideEffects": false,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pixelersagency/leiho.git",
		"directory": "bridge"
	},
	"homepage": "https://github.com/pixelersagency/leiho#readme",
	"peerDependencies": {
		"react": ">=17"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		}
	},
	"bin": {
		"leiho": "bin/leiho.js"
	},
	"engines": {
		"node": ">=18"
	}
}
