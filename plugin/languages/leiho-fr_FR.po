msgstr "Voir le build"

#: includes/admin/class-leiho-dashboard.php:2292
msgid "Weekly activity"
msgstr "Activité par semaine"

#: includes/admin/class-leiho-dashboard.php:2297
msgid "Week"
msgstr "Semaine"

#: includes/admin/class-leiho-dashboard.php:2298
msgid "Saves"
msgstr "Enregistrements"

#: includes/admin/class-leiho-dashboard.php:2299
msgid "Deployments"
msgstr "Publications"

#: includes/admin/class-leiho-dashboard.php:2330
msgid "Live content"
msgstr "Contenu en direct"

#: includes/admin/class-leiho-dashboard.php:2331
msgid "The site reads WordPress on every visit. Saving is enough, nothing to publish."
msgstr "Le site lit WordPress à chaque visite. Enregistrer suffit, rien à publier."

#: includes/admin/class-leiho-dashboard.php:2334
msgid "Build hook"
msgstr "Build hook"

#: includes/admin/class-leiho-dashboard.php:2335
msgid "Vercel, Netlify, Cloudflare Pages… Leiho calls the rebuild URL."
msgstr "Vercel, Netlify, Cloudflare Pages… Leiho appelle l’URL de rebuild."

#: includes/admin/class-leiho-dashboard.php:2338
msgid "GitHub Actions"
msgstr "GitHub Actions"

#: includes/admin/class-leiho-dashboard.php:2339
msgid "Triggers a workflow and tracks the build live."
msgstr "Déclenche un workflow et suit le build en direct."

#: includes/admin/class-leiho-dashboard.php:2342
msgid "GitHub commit"
msgstr "Commit GitHub"

#: includes/admin/class-leiho-dashboard.php:2343
msgid "For hosts that deploy on every push."
msgstr "Pour les hébergeurs qui déploient à chaque push."

#: includes/admin/class-leiho-dashboard.php:2346
msgid "Coolify"
msgstr "Coolify"

#: includes/admin/class-leiho-dashboard.php:2347
