msgstr "Enregistré — laisser vide pour le conserver"

#: includes/admin/class-leiho-dashboard.php:2227
msgid "This secret can’t be read anymore: the WordPress salts have changed (host or security plugin). Enter it again."
msgstr "Ce secret n’est plus lisible : les salts WordPress ont changé (hébergeur ou plugin de sécurité). Saisissez-le à nouveau."

#: includes/admin/class-leiho-dashboard.php:2229
msgid "Delete this secret"
msgstr "Supprimer ce secret"

#: includes/admin/class-leiho-dashboard.php:2251
msgid "Deployment history"
msgstr "Historique des publications"

#: includes/admin/class-leiho-dashboard.php:2256
msgid "No deployments yet"
msgstr "Aucune publication"

#: includes/admin/class-leiho-dashboard.php:2257
msgid "Every click on “Publish” in the editor shows up here with its result."
msgstr "Chaque clic sur « Publier » dans l’éditeur apparaîtra ici avec son résultat."

#: includes/admin/class-leiho-dashboard.php:2264
msgid "By"
msgstr "Par"

#: includes/admin/class-leiho-dashboard.php:2265
msgid "Method"
msgstr "Méthode"

#: includes/admin/class-leiho-dashboard.php:2266
msgid "Result"
msgstr "Résultat"

#: includes/admin/class-leiho-dashboard.php:2281
