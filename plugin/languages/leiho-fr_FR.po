msgstr "Adresse (slug)"

#: includes/class-leiho-native-fields.php:161
msgid "The last part of the address. Lowercase letters, digits and hyphens."
msgstr "La fin de l’adresse. Minuscules, chiffres et tirets."

#: includes/class-leiho-native-fields.php:165
msgid "Publish date"
msgstr "Date de publication"

#: includes/class-leiho-native-fields.php:166
msgid "A future date schedules a published entry."
msgstr "Une date future programme une entrée publiée."

#: includes/class-leiho-native-fields.php:170
msgid "Author"
msgstr "Auteur"

#: includes/class-leiho-native-fields.php:176
